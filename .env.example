PORT=3000
# Exact browser origin, including a non-default port. Production requires HTTPS.
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27018/the_daily_web?replicaSet=rs0
# One shared weather location.
WEATHER_LOCATION=Tel Aviv
WEATHER_LATITUDE=32.0853
WEATHER_LONGITUDE=34.7818
# Only for npm run seed:demo, which also needs MONGODB_URI to name a database ending in _demo. 8-128 characters each.
DEMO_REPORTER_PASSWORD=
DEMO_EDITOR_PASSWORD=
