<header class="site-header">
  <a class="brand" href="/">The Daily Web</a>
  <nav class="header-actions" aria-label="Main">
    <a href="/">Latest</a>
    <% if (locals.user) { %>
      <% if (user.role === 'reporter') { %><a href="/reporter">My articles</a><% } %>
      <% if (user.role === 'editor') { %><a href="/editor">Editor desk</a><% } %>
      <span class="header-user"><%= user.displayName %></span>
      <form method="post" action="/auth/logout"><button class="text-button" type="submit">Sign out</button></form>
    <% } else { %>
      <a href="/auth">Sign in</a>
    <% } %>
  </nav>
</header>
