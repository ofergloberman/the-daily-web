<%# Expects `article`: { _id, published: { title, summary, category, imageUrl }, author: { displayName }, publishedAt } %>
<article class="article-card" data-id="<%= article._id %>">
  <% if (article.published.imageUrl) { %><img class="card-image" src="<%= article.published.imageUrl %>" alt="" loading="lazy"><% } %>
  <div class="card-body">
    <% if (article.published.category) { %><p class="card-category"><%= article.published.category %></p><% } %>
    <h2 class="card-title"><a href="/articles/<%= article._id %>"><%= article.published.title || 'Untitled article' %></a></h2>
    <% if (article.published.summary) { %><p class="card-summary"><%= article.published.summary %></p><% } %>
    <p class="card-meta"><%= article.author?.displayName || 'Staff' %><% if (article.publishedAt) { %> &middot; <time datetime="<%= new Date(article.publishedAt).toISOString() %>"><%= formatDate(article.publishedAt) %></time><% } %></p>
  </div>
</article>
