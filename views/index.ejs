<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: null, description: 'Latest news from The Daily Web.' }) %>
</head>
<body>
  <%- include('partials/header') %>
  <div class="page-shell">
    <main class="page-main">
      <p class="section-label">Latest news</p>
      <section class="article-list" id="feed" aria-live="polite">
        <% if (!locals.articles || !articles.length) { %>
          <div class="empty-state"><h2>No articles yet</h2><p>Published stories will appear here.</p></div>
        <% } else { articles.forEach(article => { %>
          <%- include('partials/articleCard', { article }) %>
        <% }) } %>
      </section>
    </main>
    <%- include('partials/sidebar') %>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
